{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CONEXAO",
  "type": "object",
  "required": ["id", "origem_id", "destino_id", "relacao", "criada_em"],
  "properties": {
    "id": {"type": "string", "pattern": "^CONX-[0-9]{8}-[0-9]{4}$"},
    "origem_id": {"type": "string", "minLength": 1},
    "destino_id": {"type": "string", "minLength": 1},
    "relacao": {"type": "string", "minLength": 1},
    "evidencias": {"type": "array", "items": {"type": "string", "pattern": "^EVID-[0-9]{8}-[0-9]{4}$"}},
    "criada_em": {"type": "string", "format": "date-time"},
    "status": {"type": "string", "enum": ["descoberta", "validada", "contestada", "superada"]}
  },
  "additionalProperties": false
}